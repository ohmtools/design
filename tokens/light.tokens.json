{
  "$description": "ohmtools theme, light mode: zeiteisen's redesign on shadcn base-vega (white ground, neutral primary, red as the one accent). Generated outputs: npm run build.",
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      },
      "$description": "Page ground: white, OLED black in dark mode."
    },
    "foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0392, 0.0392, 0.0392],
        "hex": "#0a0a0a"
      },
      "$description": "Text and icons on the background."
    },
    "card": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9804, 0.9804, 0.9804],
        "hex": "#fafafa"
      },
      "$description": "Card surface, a step above the ground. Sections drop it (no boxes), so it is rarely seen."
    },
    "card-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0392, 0.0392, 0.0392],
        "hex": "#0a0a0a"
      },
      "$description": "Text on card."
    },
    "popover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9804, 0.9804, 0.9804],
        "hex": "#fafafa"
      },
      "$description": "Floating surfaces (popovers, menus, dialogs, sheets, drawers, toasts), always as frosted glass: at 72 % over a blurred backdrop (`popup-glass`)."
    },
    "popover-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0392, 0.0392, 0.0392],
        "hex": "#0a0a0a"
      },
      "$description": "Text and icons on popover."
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0392, 0.0392, 0.0392],
        "hex": "#0a0a0a"
      },
      "$description": "The main action: neutral, black on light, white on dark. Red is never primary (accent-red)."
    },
    "primary-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9804, 0.9804, 0.9804],
        "hex": "#fafafa"
      },
      "$description": "Text and icons on primary."
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.898, 0.898, 0.898],
        "hex": "#e5e5e5"
      },
      "$description": "Secondary buttons."
    },
    "secondary-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0392, 0.0392, 0.0392],
        "hex": "#0a0a0a"
      },
      "$description": "Text on secondary."
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9608, 0.9608, 0.9608],
        "hex": "#f5f5f5"
      },
      "$description": "Subtle fills: the tab track, hover of ghost and outline controls."
    },
    "muted-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.451, 0.451, 0.451],
        "hex": "#737373"
      },
      "$description": "Secondary text: descriptions, hints, captions, trailing notes, icons in lists."
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9608, 0.9608, 0.9608],
        "hex": "#f5f5f5"
      },
      "$description": "Highlighted item in menus, lists and selects; a pressed toggle (an open panel's button)."
    },
    "accent-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0392, 0.0392, 0.0392],
        "hex": "#0a0a0a"
      },
      "$description": "Text on accent."
    },
    "destructive": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8627, 0.149, 0.149],
        "hex": "#dc2626"
      },
      "$description": "Red text: errors, invalid fields, destructive menu items. A destructive button is filled accent-red."
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
