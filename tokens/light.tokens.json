    },
    "accent-red": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8627, 0.149, 0.149],
        "hex": "#dc2626"
      },
      "$description": "The one accent, the same in both modes: marks that must stand out (today, the now-line, the picked day, the app tile, an update waiting) and the fill of destructive buttons. Tailwind: bg-red, text-red.",
      "$extensions": {
        "dev.ohmtools": {
          "tailwind": "red"
        }
      }
    },
    "accent-red-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
