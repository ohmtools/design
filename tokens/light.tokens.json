{
  "$description": "ohmtools theme, light mode: shadcn Red on Neutral (style base-sera). Generated outputs: npm run build.",
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [1, 0, 0]
      },
      "$description": "Page background."
    },
